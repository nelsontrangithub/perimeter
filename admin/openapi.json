  "info": {
    "title": "Perimeter",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/admin/api/acl/invalidate": {
      "post": {
        "description": "The ADR-004 invalidation hook. Call on any membership change, either direction.",
        "operationId": "invalidateAcl",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AclInvalidate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Invalidateacl",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Acl Invalidate",
        "tags": [
          "admin"
        ]
      }
    },
    "/admin/api/connectors": {
      "get": {
        "operationId": "listConnectors",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ConnectorView"
                  },
                  "title": "Response Listconnectors",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Connectors",
        "tags": [
          "admin"
        ]
      },
      "post": {
        "operationId": "createConnector",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectorCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectorView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Connector",
        "tags": [
          "admin"
        ]
      }
    },
    "/admin/api/connectors/{name}": {
      "delete": {
        "operationId": "deleteConnector",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Connector",
        "tags": [
          "admin"
        ]
      }
    },
    "/admin/api/connectors/{name}/ingest": {
      "post": {
        "operationId": "ingestConnector",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestRunView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ingest Connector",
        "tags": [
          "admin"
        ]
      }
    },
    "/admin/api/index": {
      "get": {
        "operationId": "indexHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
